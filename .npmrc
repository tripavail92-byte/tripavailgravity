virtual-store-dir-max-length=30

# Babel resolves presets/plugins from the project root, but pnpm's strict linking keeps
# transitive @babel/* plugins out of it — release bundling (expo export:embed) then dies with
# "Cannot find module '@babel/plugin-transform-...'" one plugin at a time. Hoist the babel
# toolchain so Babel can always resolve it. Build-time only; runtime deps are unaffected.
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=babel-preset-expo
